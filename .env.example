# Exemple : aucune vraie valeur ici. Les valeurs de production sont dans Coolify.
# Ne jamais builder en local avec la base de production (bun run build applique les migrations).
DATABASE_URI=postgres://postgres:motdepasse@localhost:5432/isabelle
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=a-remplir

S3_BUCKET=cinquin-isabelle
S3_ACCESS_KEY_ID=a-remplir
S3_SECRET_ACCESS_KEY=a-remplir
S3_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
S3_REGION=auto

RESEND_API_KEY=a-remplir
FORVOYEZ_TOKEN=a-remplir
GEMINI_API_KEY=a-remplir
REVALIDATE_SECRET=a-remplir
