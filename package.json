{
	"name": "isabelle-cinquin",
	"version": "2.0.0",
	"description": "Isabelle Cinquin - Nounou Sciez - with Payload CMS",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "NODE_ENV=production tsx src/scripts/migrate.ts && NODE_ENV=production next build",
		"dev": "next dev",
		"generate:importmap": "payload generate:importmap",
		"generate:types": "payload generate:types",
		"check": "biome check --write",
		"lint": "biome lint --write",
		"format": "biome format --write",
		"payload": "payload",
		"start": "next start",
		"test:e2e": "bash e2e/docker.sh",
		"typecheck": "tsc --noEmit",
		"lint:ci": "biome ci .",
		"test": "vitest run --project unitaires",
		"test:unit": "vitest run --project unitaires",
		"test:integration": "vitest run --project integration",
		"test:e2e:maj-captures": "bash e2e/docker.sh --update-snapshots"
	},
	"overrides": {
		"next": "$next",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/accessibility": "^3.1.1",
		"dompurify": "3.4.17",
		"fast-uri": "3.1.9",
		"fast-xml-parser": "5.11.2",
		"happy-dom": "21.0.4",
		"immutable": "4.3.9",
		"js-yaml": "4.3.2",
		"lodash": "4.18.1",
		"postcss": "$postcss",
		"source-map-js": "1.2.2",
		"undici": "7.30.1",
		"ws": "8.22.1"
	},
	"dependencies": {
		"@ai-sdk/google": "4.0.111",
		"@number-flow/react": "0.6.2",
		"@paper-design/shaders-react": "0.0.76",
		"@payloadcms/db-postgres": "3.92.1",
		"@payloadcms/live-preview-react": "3.92.1",
		"@payloadcms/next": "3.92.1",
		"@payloadcms/richtext-lexical": "3.92.1",
		"@payloadcms/storage-s3": "3.92.1",
		"@payloadcms/ui": "3.92.1",
		"@radix-ui/react-accordion": "1.3.1",
		"@radix-ui/react-aspect-ratio": "1.2.0",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-separator": "1.2.0",
		"@radix-ui/react-slot": "1.5.0",
		"@tabler/icons-react": "3.50.0",
		"@tailwindcss/postcss": "4.3.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tsparticles/engine": "4.5.1",
		"@tsparticles/react": "4.5.1",
		"@tsparticles/slim": "4.5.1",
		"ai": "7.0.162",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"framer-motion": "12.42.2",
		"graphql": "16.14.2",
		"lucide-react": "0.577.0",
		"next": "16.4.5",
		"payload": "3.92.1",
		"postcss": "8.5.32",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"resend": "6.37.0",
		"sharp": "0.35.5",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.4",
		"tsx": "4.23.15",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"engines": {
		"node": ">=22.21.0"
	},
	"packageManager": "bun@1.3.4",
	"trustedDependencies": [
		"sharp",
		"esbuild",
		"unrs-resolver"
	]
}
